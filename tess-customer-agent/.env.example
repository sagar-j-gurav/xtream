# TESS Environment Configuration Template
# Copy this file to .env.dev, .env.uat, or .env.prod and fill in the values

# Application
APP_ENV=dev  # dev | uat | prod
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO  # DEBUG for dev, INFO for uat/prod

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Frappe MCP (SEREBR)
FRAPPE_MCP_URL=http://localhost:3000/sse
FRAPPE_API_KEY=your-frappe-api-key
FRAPPE_API_SECRET=your-frappe-api-secret
MCP_TIMEOUT=30000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tess_conversations
POSTGRES_USER=tess_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_POOL_SIZE=10

# ChromaDB
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=knowledge_base
CHROMA_TOP_K=5
CHROMA_SIMILARITY_THRESHOLD=0.7

# Agent Configuration
MAX_CONVERSATION_HISTORY=10
CONVERSATION_SUMMARY_THRESHOLD=15
SESSION_TIMEOUT_HOURS=24
MAX_RETRIES=3
RETRY_BACKOFF_MULTIPLIER=2
